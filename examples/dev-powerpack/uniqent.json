{
  "specVersion": "0.1",
  "name": "dev-powerpack",
  "displayName": "Dev Powerpack",
  "version": "0.1.0",
  "description": "A coding-focused agent with GitHub and filesystem MCP access and a daily standup briefing.",
  "author": {
    "name": "Uniqent Examples",
    "handle": "uniqent",
    "url": "https://uniqent.dev"
  },
  "license": "CC0-1.0",
  "tags": ["developer", "github", "coding"],
  "components": {
    "identity": true,
    "memory": { "facts": 3, "episodic": 0, "hasProfile": true },
    "skills": ["code-review", "release-notes"],
    "mcp": ["github", "filesystem"],
    "tools": ["web-search"],
    "tasks": ["daily-standup"],
    "channels": ["telegram"]
  },
  "credentials": [
    {
      "ref": "github_pat",
      "label": "GitHub Personal Access Token",
      "type": "apiKey",
      "consumedBy": ["mcp:github"],
      "required": true,
      "help": "Create at https://github.com/settings/tokens with repo scope."
    },
    {
      "ref": "telegram_bot_token",
      "label": "Telegram Bot Token",
      "type": "bearer",
      "consumedBy": ["channel:telegram"],
      "required": false,
      "help": "Create a bot with @BotFather."
    }
  ],
  "permissions": {
    "filesystem": { "read": ["~/code/**"], "write": ["~/code/**"] },
    "network": { "endpoints": ["api.github.com"] },
    "autonomy": "suggest",
    "spawnsProcesses": true,
    "notes": "Runs the filesystem MCP server as a local subprocess."
  },
  "compatibility": {
    "targets": ["openclaw", "hermes", "claude-code"]
  }
}
