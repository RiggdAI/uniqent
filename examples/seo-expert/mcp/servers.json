{
  "servers": [
    {
      "id": "brave",
      "transport": "streamable-http",
      "url": "https://server.smithery.ai/brave/mcp",
      "auth": {
        "type": "bearer",
        "credentialRef": "smithery_api_key"
      },
      "tools": {
        "include": "all"
      },
      "description": "Brave Search — web/SERP research"
    },
    {
      "id": "google-search-console",
      "transport": "streamable-http",
      "url": "https://server.smithery.ai/google-search-console/mcp",
      "auth": {
        "type": "bearer",
        "credentialRef": "smithery_api_key"
      },
      "tools": {
        "include": "all"
      },
      "description": "Google Search Console — site performance in Search"
    },
    {
      "id": "keywords-everywhere",
      "transport": "streamable-http",
      "url": "https://server.smithery.ai/keywords-everywhere/mcp",
      "auth": {
        "type": "bearer",
        "credentialRef": "smithery_api_key"
      },
      "tools": {
        "include": "all"
      },
      "description": "Keywords Everywhere — keyword volume, difficulty, backlinks"
    },
    {
      "id": "fetch",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "auth": {
        "type": "none"
      },
      "tools": {
        "include": "all"
      },
      "description": "Web fetch MCP server"
    }
  ]
}
