{
  "name": "@uniqent/builder",
  "version": "0.3.0",
  "description": "Framework-agnostic engine to assemble a brain into a validated .uniqent bundle.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hubs": {
      "types": "./dist/hubs-entry.d.ts",
      "default": "./dist/hubs-entry.js"
    },
    "./memory": {
      "types": "./dist/memory-entry.d.ts",
      "default": "./dist/memory-entry.js"
    },
    "./brain": {
      "types": "./dist/brain-entry.d.ts",
      "default": "./dist/brain-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@uniqent/core": "workspace:^",
    "@uniqent/spec": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RiggdAI/uniqent.git",
    "directory": "packages/builder"
  },
  "homepage": "https://github.com/RiggdAI/uniqent#readme"
}
