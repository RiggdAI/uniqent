{
  "name": "@uniqent/cli",
  "version": "0.2.0",
  "description": "The `uniqent` CLI — inspect and install .uniqent bundles.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "uniqent": "./dist/bin.js"
  },
  "main": "./dist/run.js",
  "types": "./dist/run.d.ts",
  "files": [
    "dist",
    "featured"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/build-featured.ts",
    "build:featured": "tsx scripts/build-featured.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@uniqent/adapter-claude-code": "workspace:^",
    "@uniqent/adapter-hermes": "workspace:^",
    "@uniqent/adapter-openclaw": "workspace:^",
    "@uniqent/adapter-sdk": "workspace:^",
    "@uniqent/builder": "workspace:^",
    "@uniqent/core": "workspace:^"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RiggdAI/uniqent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RiggdAI/uniqent#readme"
}
