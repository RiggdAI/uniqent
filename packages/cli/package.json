{
  "name": "@uniqent/cli",
  "version": "0.1.0",
  "description": "The `uniqent` CLI — inspect and install .uniqent bundles.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "uniqent": "./dist/bin.js"
  },
  "main": "./dist/run.js",
  "types": "./dist/run.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@uniqent/adapter-claude-code": "workspace:*",
    "@uniqent/adapter-hermes": "workspace:*",
    "@uniqent/adapter-sdk": "workspace:*",
    "@uniqent/core": "workspace:*"
  },
  "devDependencies": {
    "@uniqent/builder": "workspace:*",
    "vitest": "^3.0.0"
  }
}
