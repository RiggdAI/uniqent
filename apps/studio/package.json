{
  "name": "@uniqent/studio",
  "version": "0.1.0",
  "description": "Uniqent Studio — the local-first visual builder for portable AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsx watch src/server/index.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@xyflow/react": "^12.3.5",
    "@uniqent/builder": "workspace:*",
    "@uniqent/core": "workspace:*",
    "@uniqent/spec": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
