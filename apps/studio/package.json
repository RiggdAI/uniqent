{
  "name": "@uniqent/studio",
  "version": "0.1.0",
  "description": "Uniqent Studio — the local-first visual builder for portable AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "fixtures": "tsx scripts/emit-fixtures.ts && prettier --write fixtures",
    "fixtures:core": "tsx scripts/emit-core-fixtures.ts && prettier --write fixtures/core",
    "fixtures:ports": "tsx scripts/emit-port-fixtures.ts && prettier --write fixtures/ports"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uniqent/adapter-claude-code": "workspace:^",
    "@uniqent/adapter-hermes": "workspace:^",
    "@uniqent/adapter-openclaw": "workspace:^",
    "@uniqent/adapter-sdk": "workspace:^",
    "@uniqent/builder": "workspace:^",
    "@uniqent/core": "workspace:^",
    "@uniqent/spec": "workspace:^",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
