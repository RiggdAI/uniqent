{
  "manifest": {
    "specVersion": "0.1",
    "name": "fixture-brain",
    "displayName": "My Brain",
    "version": "1.2.3",
    "description": "A fixture brain for cross-impl tests",
    "author": {
      "name": "Anonymous"
    },
    "license": "CC0-1.0",
    "tags": [],
    "components": {
      "identity": true,
      "memory": {
        "facts": 2,
        "episodic": 0,
        "hasProfile": true
      },
      "skills": ["fixture-skill"],
      "mcp": ["custom-api", "github"],
      "tools": [],
      "tasks": ["task-1"],
      "channels": ["telegram"]
    },
    "credentials": [
      {
        "ref": "github_pat",
        "label": "GitHub Personal Access Token",
        "type": "apiKey",
        "consumedBy": ["mcp:github"],
        "required": true,
        "help": "Create at https://github.com/settings/tokens with the scopes you need."
      },
      {
        "ref": "telegram_bot_token",
        "label": "Telegram Bot Token",
        "type": "bearer",
        "consumedBy": ["channel:telegram"],
        "required": true,
        "help": "Create a bot with @BotFather and copy its token."
      }
    ],
    "permissions": {
      "filesystem": {
        "read": [],
        "write": []
      },
      "network": {
        "endpoints": ["api.example.com", "api.githubcopilot.com"]
      },
      "autonomy": "suggest",
      "spawnsProcesses": false
    },
    "compatibility": {
      "targets": ["claude-code", "hermes"]
    }
  },
  "validation": {
    "ok": true,
    "errors": [],
    "warnings": []
  },
  "persona": "# Persona\n\nYou are the fixture.",
  "readme": "# Readme\n\nFixture readme."
}
