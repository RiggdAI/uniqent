            "LANG": "en"
          }
        }
      }
    },
    "expected": {
      "servers": [
        {
          "id": "brave-search",
          "transport": "stdio",
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-brave-search"],
          "env": {
            "BRAVE_API_KEY": "${credentialRef:brave-search_brave_api_key}",
            "LANG": "en"
          },
          "auth": {
            "type": "none"
          },
          "tools": {
            "include": "all"
          }
        }
      ],
      "credentials": [
        {
          "ref": "brave-search_brave_api_key",
          "label": "BRAVE_API_KEY",
          "type": "apiKey",
          "consumedBy": ["mcp:brave-search"],
          "required": true
        }
      ],
      "lossiness": []
    }
